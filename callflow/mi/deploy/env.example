# callflow_portal/.env (loaded by settings.py). MI reads the Smartcare account from:
STCC_SMARTCARE_DB_USER=<Smartcare user>
STCC_SMARTCARE_DB_PASSWORD=<value>

# Optional overrides (defaults shown)
# MI_OUTPUT_DIR=/home/AutomationProjects/CallFlowTool/backend/callflow_portal/callflow_output/MI
# MI_LEGACY_EXPORT_DIR=/home/Shorouk/CallFlow
# MI_LOG_RETENTION_DAYS=14
# MI_JOB_RETENTION_DAYS=7
# MI_EXECUTOR=worker
# MI_WORKER_FALLBACK=local
# MI_MAX_CONCURRENT=1
# MI_QUERY_PARALLELISM=4
# MI_LEGACY_ENDPOINT_MODE=sync
# MI_DAILY_SUBMISSION_LIMIT=100
# MI_DAILY_LIMIT_TIMEZONE=Africa/Cairo     # default: settings.TIME_ZONE (UTC)
# MI_MAX_COMPLAINT_GROUPS=20
# MI_JOB_TTL_S=86400
# DataCube: every query = one ~3h session; account limit 100
# MI_MAX_QUERIES_PER_REQUEST=12
# MI_DATACUBE_SESSION_BUDGET=60        # MI's share of the 100
# MI_DATACUBE_SESSION_TTL_S=11700
# MI_DATACUBE_WAIT_S=1800
# MI_UNION_DAY_TABLES=True
# MI_DATACUBE_SESSIONS_PER_REQUEST=4    # observed: one session per connection, 4 per request
# MI_SMARTCARE_MAX_ATTEMPTS=3           # executions per query (1 = never retry)
# MI_SMARTCARE_RETRY_JITTER=0.25
