# callflow_portal/.env (loaded by settings.py). MI reads the Smartcare account from:
STCC_SMARTCARE_DB_USER=<Smartcare user>
STCC_SMARTCARE_DB_PASSWORD=<value>

# Optional overrides (defaults shown)
# MI_OUTPUT_DIR=/home/AutomationProjects/CallFlowTool/backend/callflow_portal/callflow_output/MI
# MI_LEGACY_EXPORT_DIR=/home/Shorouk/CallFlow
# MI_LOG_RETENTION_DAYS=14
# MI_JOB_RETENTION_DAYS=7
# MI_EXECUTOR=worker
# MI_WORKER_FALLBACK=local
# MI_MAX_CONCURRENT=1
# MI_QUERY_PARALLELISM=4
# MI_LEGACY_ENDPOINT_MODE=sync
